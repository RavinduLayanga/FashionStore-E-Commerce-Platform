PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5001/api

# PostgreSQL
DATABASE_URL="your database link"
DIRECT_URL=

# Admin Authentication & Seed Defaults
ADMIN_DEFAULT_NAME="System Admin"
ADMIN_DEFAULT_EMAIL="admin@ecommerce.lk"
ADMIN_DEFAULT_PASSWORD=your_secure_password_here

JWT_SECRET="generate_a_random_48_char_base64_string_here"
JWT_EXPIRES_IN=1d

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=your_sandbox_merchant_id
PAYHERE_SECRET=your_sandbox_secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout

# WhatsApp Business Configuration
WHATSAPP_BUSINESS_PHONE=your_wp_account_number
