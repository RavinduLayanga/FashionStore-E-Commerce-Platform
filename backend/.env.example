PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5435/ecommerce_db?schema=public&connection_limit=50"

# Admin Authentication & Seed Defaults
ADMIN_DEFAULT_NAME="System Admin"
ADMIN_DEFAULT_EMAIL="admin@ecommerce.lk"
ADMIN_DEFAULT_PASSWORD="Default@17856"

JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_intern_assessment
JWT_EXPIRES_IN=1d

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout

# WhatsApp Business Configuration
WHATSAPP_BUSINESS_PHONE=94770000000


